# RunFree Client Portal — environment
#
# Note what is NOT here: content folder ids. In the Certified Vision Framers
# portal those are environment variables, which is precisely why one deploy can
# only serve one audience. Here every Drive folder lives on its project row.

# Supabase
#
# THE SAME PROJECT AS THE CERTIFIED VISION FRAMERS PORTAL — deliberately.
#
# Both portals share auth.users, so one person has one login even if they are
# both a Certified Vision Framer and a client. Sharing later is not an option:
# it would mean re-inviting everyone and losing their passwords. Splitting later
# is easy. So shared is the reversible choice.
#
# It also removes an ongoing tax — one set of email templates, one SMTP config,
# one redirect allowlist, one place to add or remove a person.
#
# The two table sets do not collide:
#   CVF portal    certified_framers, training_videos, ghl_sync_log
#   this portal   profiles, projects, project_members, sessions, deliverables,
#                 templates
# Row-level security is per-table, so policies here cannot affect the live
# portal. The real risk is a careless migration, not the sharing itself: never
# write a migration that touches a table you do not own.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role. Reserved for genuine admin operations with no user context —
# inviting someone, provisioning a project. It bypasses row-level security, so
# every request made on behalf of a signed-in person must use their own token
# instead, or the isolation model is decorative.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive
# One service account with access to every project folder. Which folder a
# project reads is stored on the project, not here.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

NODE_ENV=development

# ---------------------------------------------------------------------------
# Not set yet — see BRIEF.md, "Invitation emails"
#
# Supabase has ONE set of email templates per project, and they are already
# branded for Certified Vision Framers. A church client should not receive an
# email about certification. The fix is to mint the link with Supabase's admin
# API and send the email from here instead, which is also the only way to get
# per-portal branding. Pick a sender when you get to invitations.
# RESEND_API_KEY=
